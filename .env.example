# Server (optional — defaults are safe for local-only use)
VIDEODOWNLOAD_HOST=127.0.0.1
VIDEODOWNLOAD_PORT=8200
# Public URL/IP that remote browsers should use for bridge/userscript callbacks.
# Example: http://203.0.113.10:8200 or http://rdp-hostname:8200
# VIDEODOWNLOAD_PUBLIC_URL=http://127.0.0.1:8200
# Optional regional outbound proxy for service login/manifest/license requests.
# Use this when the server IP is outside the account's supported region.
# VIDEODOWNLOAD_PROXY_URL=http://user:pass@proxy.example:8080
VIDEODOWNLOAD_API_KEY=
VIDEODOWNLOAD_LOCALHOST_BYPASS=true
VIDEODOWNLOAD_CORS_ORIGINS=http://127.0.0.1:8200,http://localhost:8200,http://127.0.0.1:5173,http://localhost:5173
VIDEODOWNLOAD_ALLOW_DRM_KEY_EXPORT=false

# Tampermonkey userscript backend URL (default http://127.0.0.1:8200)
# VIDEODOWNLOAD_BACKEND_URL=http://127.0.0.1:8200

# Frontend dev (Vite :5173) — optional API key for backend
VITE_API_KEY=
VITE_BACKEND_PORT=8200
