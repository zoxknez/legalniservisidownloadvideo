// Interface definitions
interface BinaryStatus {
  found: boolean;
  path: string;
}

interface ServiceStatus {
  authenticated: boolean;
  ready?: boolean;
  engine_installed?: boolean;
  engine_download_supported?: boolean;
  dependency_ready?: boolean;
  engine_status?: {
    message?: string;
    download_supported?: boolean;
    cdm_ready?: boolean;
    api?: {
      configured?: boolean;
      base_url?: string;
    };
    token?: {
      configured?: boolean;
      expires_at?: string | null;
      expired?: boolean;
    };
  };
  email?: string;
  username?: string;
  nickname?: string;
  subscribed?: boolean;
  error?: string;
  serial?: string;
