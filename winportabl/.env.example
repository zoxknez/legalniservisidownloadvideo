# Server (optional — defaults are safe for local-only use)
VIDEODOWNLOAD_API_KEY=
VIDEODOWNLOAD_LOCALHOST_BYPASS=true
VIDEODOWNLOAD_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
VIDEODOWNLOAD_ALLOW_DRM_KEY_EXPORT=false

# Tampermonkey userscript backend URL (default http://127.0.0.1:8000)
# VIDEODOWNLOAD_BACKEND_URL=http://127.0.0.1:8000

# Frontend dev (Vite :5173) — optional API key for backend
VITE_API_KEY=
