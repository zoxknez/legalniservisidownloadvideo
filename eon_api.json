{
  "base_url": "https://api.example.com",
  "headers": {
    "User-Agent": "Mozilla/5.0 EONSafeDownloader/1.0",
    "Accept": "application/json"
  },
  "auth_header": "Authorization",
  "auth_scheme": "Bearer",
  "endpoints": {
    "login": {
      "method": "POST",
      "path": "/login",
      "json": {
        "username": "{username}",
        "password": "{password}",
        "deviceSerial": "{device_serial}",
        "deviceNumber": "{device_number}"
      }
    },
    "refresh": {
      "method": "POST",
      "path": "/refresh",
      "json": {
        "refreshToken": "{refresh_token}"
      }
    },
    "channels": {
      "method": "GET",
      "path": "/channels"
    },
    "epg": {
      "method": "GET",
      "path": "/epg",
      "params": {
        "channel": "{channel}"
      }
    },
    "search": {
      "method": "GET",
      "path": "/vod/search",
      "params": {
        "q": "{query}"
      }
    },
    "vod_detail": {
      "method": "GET",
      "path": "/vod/{target}"
    },
    "series": {
      "method": "GET",
      "path": "/series/{series_id}"
    },
    "resolve": {
      "method": "GET",
      "path": "/playback/{target}",
      "params": {
        "kind": "{kind}"
      }
    }
  }
}
